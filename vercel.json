{
  "rewrites": [
    {
      "source": "/challenge",
      "destination": "/challenge.html"
    },
    {
      "source": "/results",
      "destination": "/results.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}